# Copy this file to .env and fill in real values. Never commit .env.

# Google AI Studio key for Gemini (vocabulary extraction)
GEMINI_API_KEY=

# DeepL Developer (free tier) API key
DEEPL_API_KEY=

# Firebase project config (from Firebase Console > Project Settings)
FIREBASE_PROJECT_ID=

# Path to (or JSON contents of) the Firebase Admin service account key,
# used by the server to verify logged-in users and talk to Firestore securely.
FIREBASE_SERVICE_ACCOUNT_JSON=

PORT=3001
